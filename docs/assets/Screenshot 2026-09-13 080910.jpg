<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 650" width="600" height="650">
  <defs>
    <linearGradient id="ignJarMetal" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#334155" />
      <stop offset="20%" stop-color="#64748b" />
      <stop offset="40%" stop-color="#94a3b8" />
      <stop offset="60%" stop-color="#cbd5e1" />
      <stop offset="85%" stop-color="#475569" />
      <stop offset="100%" stop-color="#1e293b" />
    </linearGradient>

    <linearGradient id="ignLidGrad" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#0f172a" />
      <stop offset="30%" stop-color="#1e293b" />
      <stop offset="50%" stop-color="#475569" />
      <stop offset="80%" stop-color="#1e293b" />
      <stop offset="100%" stop-color="#090d16" />
    </linearGradient>

    <linearGradient id="ignGoldFoil" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#fef08a" />
      <stop offset="25%" stop-color="#fbbf24" />
      <stop offset="65%" stop-color="#d97706" />
      <stop offset="100%" stop-color="#b45309" />
    </linearGradient>

    <linearGradient id="ignGoldBanner" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#b45309" />
      <stop offset="25%" stop-color="#d97706" />
      <stop offset="60%" stop-color="#fbbf24" />
      <stop offset="100%" stop-color="#fef08a" />
    </linearGradient>

    <filter id="packShadow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="28" stdDeviation="22" flood-color="#000000" flood-opacity="0.65" />
    </filter>
  </defs>

  <!-- Ground Shadow -->
  <ellipse cx="300" cy="580" rx="210" ry="24" fill="#000000" fill-opacity="0.5" filter="blur(10px)"/>
  <ellipse cx="300" cy="578" rx="165" ry="14" fill="#000000" fill-opacity="0.75" filter="blur(4px)"/>

  <g filter="url(#packShadow)">
    <!-- Main Jar Body -->
    <rect x="125" y="150" width="350" height="410" rx="36" fill="url(#ignJarMetal)" stroke="#64748b" stroke-width="2"/>

    <!-- Screw Cap Lid with Gold Ring -->
    <rect x="128" y="90" width="344" height="74" rx="18" fill="url(#ignLidGrad)" stroke="#475569" stroke-width="2"/>
    <!-- Lid Gold Rim -->
    <rect x="140" y="95" width="320" height="12" rx="6" fill="url(#ignGoldFoil)" opacity="0.85"/>
    <text x="300" y="104" fill="#000000" font-family="sans-serif" font-weight="900" font-size="7" text-anchor="middle" letter-spacing="1">IGNITION X EXTREME PRE-WORKOUT</text>

    <!-- Lid Ribbing lines -->
    <path d="M 145 110 L 145 160 M 165 110 L 165 160 M 185 110 L 185 160 M 205 110 L 205 160 M 225 110 L 225 160 M 245 110 L 245 160 M 265 110 L 265 160 M 285 110 L 285 160 M 305 110 L 305 160 M 325 110 L 325 160 M 345 110 L 345 160 M 365 110 L 365 160 M 385 110 L 385 160 M 405 110 L 405 160 M 425 110 L 425 160 M 445 110 L 445 160" stroke="#0f172a" stroke-width="2.5"/>

    <!-- Label Wrap -->
    <rect x="140" y="175" width="320" height="360" rx="14" fill="#ffffff" stroke="#e2e8f0" stroke-width="1.5"/>

    <!-- Hexagonal Pattern on White Right Half -->
    <g stroke="#cbd5e1" stroke-width="1.2" fill="none" opacity="0.6">
      <polygon points="380,210 395,200 410,210 410,228 395,238 380,228" />
      <polygon points="410,228 425,218 440,228 440,246 425,256 410,246" />
      <polygon points="395,256 410,246 425,256 425,274 410,284 395,274" />
      <polygon points="370,410 385,400 400,410 400,428 385,438 370,428" />
      <polygon points="400,428 415,418 430,428 430,446 415,456 400,446" />
    </g>

    <!-- Left Angular Dark Background -->
    <path d="M 140 175 L 340 175 L 375 250 L 300 370 L 140 370 Z" fill="#090d16"/>
    <path d="M 140 370 L 265 370 L 220 535 L 140 535 Z" fill="#090d16"/>

    <!-- RND Logo with Winged Crest -->
    <g transform="translate(170, 205)">
      <!-- Crest Icon -->
      <polygon points="12,0 0,16 6,24 18,10 30,24 36,16 24,0 18,6" fill="url(#ignGoldFoil)"/>
      <!-- Text RND -->
      <text x="44" y="20" fill="url(#ignGoldFoil)" font-family="system-ui, -apple-system, sans-serif" font-weight="900" font-size="28" letter-spacing="2">RND</text>
      <text x="110" y="8" fill="url(#ignGoldFoil)" font-family="sans-serif" font-weight="bold" font-size="9">TM</text>
    </g>

    <!-- IGNITION X Big Chevron Banner -->
    <g transform="translate(140, 240)">
      <polygon points="0,0 230,0 260,30 230,60 0,60" fill="none" stroke="url(#ignGoldFoil)" stroke-width="2.5"/>
      <text x="24" y="44" fill="url(#ignGoldFoil)" font-family="system-ui, -apple-system, sans-serif" font-weight="900" font-size="32" letter-spacing="1">IGNITION </text>
      <text x="190" y="44" fill="#ffffff" font-family="system-ui, -apple-system, sans-serif" font-weight="900" font-size="34">X</text>
    </g>

    <!-- Subtitles -->
    <text x="165" y="322" fill="#ffffff" font-family="system-ui, -apple-system, sans-serif" font-weight="800" font-size="13" letter-spacing="1">EXTREME PRE-WORKOUT</text>
    <rect x="165" y="332" width="130" height="18" rx="4" fill="url(#ignGoldFoil)"/>
    <text x="230" y="345" fill="#090d16" font-family="sans-serif" font-weight="900" font-size="10" text-anchor="middle" letter-spacing="0.5">ADVANCED FORMULA</text>

    <!-- Round 100% Clinical Dose Badge -->
    <g transform="translate(180, 410)">
      <circle cx="28" cy="28" r="28" fill="#090d16" stroke="url(#ignGoldFoil)" stroke-width="2"/>
      <!-- Flame icon -->
      <path d="M 28 12 Q 33 20 28 26 Q 36 28 28 38 Q 20 28 28 26 Z" fill="url(#ignGoldFoil)"/>
      <text x="28" y="24" fill="#ffffff" font-family="sans-serif" font-weight="900" font-size="10" text-anchor="middle">100%</text>
      <text x="28" y="34" fill="url(#ignGoldFoil)" font-family="sans-serif" font-weight="900" font-size="7" text-anchor="middle">CLINICAL</text>
      <text x="28" y="42" fill="#cbd5e1" font-family="sans-serif" font-weight="bold" font-size="6" text-anchor="middle">DOSE</text>
    </g>

    <!-- 3 Stat Pills with Gold Left Rounded Ends -->
    <!-- Pill 1: 6000mg Citrulline Malate -->
    <g transform="translate(250, 390)">
      <rect x="0" y="0" width="185" height="26" rx="13" fill="#ffffff" stroke="#090d16" stroke-width="1.5"/>
      <rect x="0" y="0" width="60" height="26" rx="13" fill="url(#ignGoldFoil)"/>
      <text x="30" y="17" fill="#090d16" font-family="sans-serif" font-weight="900" font-size="9" text-anchor="middle">6000MG</text>
      <text x="68" y="13" fill="#090d16" font-family="sans-serif" font-weight="900" font-size="8">CITRULLINE MALATE</text>
      <text x="68" y="22" fill="#64748b" font-family="sans-serif" font-weight="bold" font-size="7">PUMP &amp; BLOOD FLOW</text>
    </g>

    <!-- Pill 2: 3200mg Beta-Alanine -->
    <g transform="translate(250, 425)">
      <rect x="0" y="0" width="185" height="26" rx="13" fill="#ffffff" stroke="#090d16" stroke-width="1.5"/>
      <rect x="0" y="0" width="60" height="26" rx="13" fill="url(#ignGoldFoil)"/>
      <text x="30" y="17" fill="#090d16" font-family="sans-serif" font-weight="900" font-size="9" text-anchor="middle">3200MG</text>
      <text x="68" y="13" fill="#090d16" font-family="sans-serif" font-weight="900" font-size="8">BETA-ALANINE</text>
      <text x="68" y="22" fill="#64748b" font-family="sans-serif" font-weight="bold" font-size="7">ENDURANCE &amp; STRENGTH</text>
    </g>

    <!-- Pill 3: 300mg Caffeine -->
    <g transform="translate(250, 460)">
      <rect x="0" y="0" width="185" height="26" rx="13" fill="#ffffff" stroke="#090d16" stroke-width="1.5"/>
      <rect x="0" y="0" width="60" height="26" rx="13" fill="url(#ignGoldFoil)"/>
      <text x="30" y="17" fill="#090d16" font-family="sans-serif" font-weight="900" font-size="9" text-anchor="middle">300MG</text>
      <text x="68" y="13" fill="#090d16" font-family="sans-serif" font-weight="900" font-size="8">CAFFEINE</text>
      <text x="68" y="22" fill="#64748b" font-family="sans-serif" font-weight="bold" font-size="7">FOCUS &amp; ENERGY</text>
    </g>

    <!-- Veg Dot & Net Quantity -->
    <g transform="translate(155, 490)">
      <rect x="0" y="0" width="16" height="16" rx="3" fill="#ffffff" stroke="#10b981" stroke-width="1.5"/>
      <circle cx="8" cy="8" r="4" fill="#10b981"/>
      <text x="24" y="9" fill="#090d16" font-family="sans-serif" font-weight="bold" font-size="7">NET QUANTITY: 300g (38 SERVINGS)</text>
      <text x="24" y="18" fill="#64748b" font-family="sans-serif" font-weight="bold" font-size="7">FRUIT PUNCH FLAVOUR</text>
    </g>

    <!-- FSSAI & Product of India on right side -->
    <text x="420" y="415" fill="#10b981" font-family="sans-serif" font-weight="900" font-size="10">fssai</text>
  </g>
</svg>
