  <defs>
    <filter id="cardShadow" x="-12%" y="-12%" width="124%" height="124%">
      <feDropShadow dx="0" dy="6" stdDeviation="10" flood-color="#000000" flood-opacity="0.07" />
    </filter>
  </defs>

  <!-- Google Pay light background -->
  <rect width="440" height="600" fill="#f0f4f9" rx="24" />

  <!-- Top Header Profile: D Deepanshu -->
  <g transform="translate(125, 36)">
    <circle cx="24" cy="24" r="24" fill="#00875a" />
    <text x="24" y="32" fill="#ffffff" font-family="system-ui, -apple-system, sans-serif" font-weight="600" font-size="24" text-anchor="middle">D</text>
    <text x="60" y="33" fill="#1e293b" font-family="system-ui, -apple-system, sans-serif" font-weight="600" font-size="24">Deepanshu</text>
  </g>

